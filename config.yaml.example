# config.yaml — логика бота (без секретов).
# Секреты и пути на хосте: env.example → .env
# Пути внутри контейнера (CLIENT_DIR, USERS_FILE, WG_ADMIN_SOCKET) — defaults в config.py.

WG_SUBNET: "10.66.66.0/24"
WG_SUBNET_V6: "fd66:66::/64"

# Client .conf
SERVER_ENDPOINT: "vpn.example.com"
WG_CLIENT_PORT: 443
WG_MTU: 1420
WG_DNS: "10.66.66.1"
CLIENT_ALLOWED_IPS: "0.0.0.0/0, ::/0"
PERSISTENT_KEEPALIVE: 25

ALLOWED_USERS:
  - 123456789
