# Скопируйте на сервере: cp env.example .env
# Актуальный шаблон: env.example (этот файл — alias для совместимости).

# --- Обязательно ---

TELEGRAM_TOKEN=123456:ABC-DEF...
WG_ADMIN_GID=999

# --- Docker Compose ---

WG_ADMIN_SOCKET_DIR=/run/wg-admin
CLIENT_DIR=/var/lib/wg/clients
BOT_STATE_DIR=./state
CONFIG_PATH=./config.yaml

# --- Опционально ---

# USERS_FILE=/app/state/users.json
