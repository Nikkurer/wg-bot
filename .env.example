# Скопируйте в .env на сервере и заполните значения.
# GID группы wg-admin на хосте: getent group wg-admin | cut -d: -f3

TELEGRAM_TOKEN=123456:ABC-DEF...

# Обязательно: числовой GID (Docker group_add не принимает имя группы)
WG_ADMIN_GID=999

# Пути на хосте (обычно менять не нужно)
WG_ADMIN_SOCKET_DIR=/run/wg-admin
CLIENT_DIR=/var/lib/wg/clients
BOT_STATE_DIR=/var/lib/wg/bot
CONFIG_PATH=/etc/wg-bot/config.yaml
