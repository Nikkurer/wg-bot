# Скопируйте: cp env.example .env
# .env — секреты и пути НА ХОСТЕ для docker compose (файл в .gitignore).
# Логика бота — config.yaml (монтируется в контейнер).

# --- Секреты (обязательно) ---

TELEGRAM_TOKEN=123456:ABC-DEF...

# --- Docker Compose (обязательно) ---

# GID группы wg-admin: getent group wg-admin | cut -d: -f3
WG_ADMIN_GID=999

# Пути на хосте → volume mounts (не путать с путями внутри контейнера в config.yaml)
HOST_WG_ADMIN_SOCKET_DIR=/run/wg-admin
HOST_CLIENT_DIR=/var/lib/wg/clients
# Локально: ./state | На сервере: /var/lib/wg/bot (+ sudo chown -R 1000:1000)
HOST_BOT_STATE_DIR=./state
# Каталог на хосте, внутри должен лежать config.yaml → /config/config.yaml в контейнере
# Локально: . | На сервере: /etc/wg-bot
HOST_CONFIG_DIR=.

# --- Логирование ---

# DEBUG=1 — подробные логи в stdout (эквивалент python main.py -vv)
DEBUG=0

# --- Устаревшие имена (обратная совместимость, лучше HOST_*) ---
# WG_ADMIN_SOCKET_DIR=/run/wg-admin
# CLIENT_DIR=/var/lib/wg/clients
# BOT_STATE_DIR=./state
