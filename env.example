# Скопируйте на сервере: cp env.example .env
# Секреты и пути хоста — только в .env (файл в .gitignore).

# --- Обязательно ---

# Токен Telegram-бота (@BotFather). Имеет приоритет над config.yaml.
TELEGRAM_TOKEN=123456:ABC-DEF...

# Числовой GID группы wg-admin на хосте (для docker compose group_add):
#   getent group wg-admin | cut -d: -f3
WG_ADMIN_GID=999

# --- Docker Compose (пути на хосте, обычно менять не нужно) ---

WG_ADMIN_SOCKET_DIR=/run/wg-admin
CLIENT_DIR=/var/lib/wg/clients
BOT_STATE_DIR=/var/lib/wg/bot
CONFIG_PATH=/etc/wg-bot/config.yaml

# --- Опционально (переопределяют config.yaml) ---

# USERS_FILE=/app/state/users.json
# WG_ADMIN_SOCKET=/run/wg-admin/wg-admin.sock

# Логи бота (задаётся в docker-compose.yml, для локального запуска):
# WGBOT_LOG_DIR=.
